+/* printf -v NAME assigns the output instead of printing it. */
+static int FAST_FUNC
+printfcmd_v(int argc, char **argv)
+{
+	int p[2], save, status;
+	char *name = argv[2], *sub;
+	struct rawbuf out = { NULL, 0, 0 };
+	char buf[1024];
+	ssize_t r;
+
+	if (!name) {
+		bb_simple_error_msg("printf: -v: option requires an argument");
+		return 2;
+	}
+	fflush_all();
+	if (pipe(p) < 0)
+		ash_msg_and_raise_perror("can't create pipe");
+	save = fcntl(1, F_DUPFD, 10);
+	dup2(p[1], 1);
+	close(p[1]);
+	argv[2] = argv[0];
+	status = printf_main(argc - 2, argv + 2);
+	argv[2] = name;
+	fflush_all();
+	dup2(save, 1);
+	close(save);
+	rb_put(&out, 'x');
+	out.n = 0;
+	out.s[0] = '\0';
+	while ((r = read(p[0], buf, sizeof(buf))) > 0) {
+		ssize_t i;
+		for (i = 0; i < r; i++)
+			rb_put(&out, buf[i]);
+	}
+	close(p[0]);
+	name = ckstrdup(name);
+	sub = split_subscript(name);
+	if (sub)
+		arr_set(name, sub, out.s, 0);
+	else
+		setvar0(name, out.s);
+	free(name);
+	free(out.s);
+	return status;
+}
