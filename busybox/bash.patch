+static int
+arr_index(struct var *vp, const char *sub, const char **key, arith_t *idx)
+{
+	*key = sub;
+	*idx = 0;
+	if (vp && (vp->flags & VASSOC))
+		return 1;
+	*idx = ash_arith(sub);
+	if (*idx < 0) {
+		arith_t top = -1;
