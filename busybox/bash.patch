+		a.narg.backquote = backquotelist;
+		al.lastp = &al.list;
+		expandarg(&a, &al, flag);
+		*al.lastp = NULL;
+		for (sp = al.list; sp; sp = sp->next)
+			len += strlen(sp->text) + 1;
+		out = q = ckmalloc(len);
+		*q = '\0';
+		for (sp = al.list; sp; sp = sp->next) {
+			q = stpcpy(q, sp->text) + 1;
+			n++;
+		}
+	}
+	exception_handler = savehandler;
+	unwindfiles(file_stop);
+	heredoclist = saveheredoclist;
+	doprompt = saveprompt;
+	wordtext = savewordtext;
+	backquotelist = savebq;
+	tokpushback = savetokpushback;
+	lasttoken = savelasttoken;
+	quoteflag = savequoteflag;
+	checkkwd = savecheckkwd;
+	ifsfree();
+	ifsfirst = savefirst;
+	ifslastp = savelast;
+	exparg = saveexparg;
+	argbackq = saveargbackq;
+	popstackmark(&smark);
+	if (inword)
+		expdest = (char *)stackblock() + startloc;
+	if (err) {
+		free(out);
+		longjmp(exception_handler->loc, 1);
+	}
