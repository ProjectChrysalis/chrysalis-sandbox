+static void
+rb_dq(struct rawbuf *rb, int c, int regex)
+{
+	if (regex && strchr("\\^$.|?*+()[]{}", c)) {
+		rb_put(rb, '\\');
+		rb_put(rb, '\\');
+	}
+	if (c == '$' || c == '`' || c == '"' || c == '\\')
+		rb_put(rb, '\\');
+	rb_put(rb, c);
