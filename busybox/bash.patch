+/* mapfile / readarray: lines of input into an array. */
+static int FAST_FUNC
+mapfilecmd(int argc UNUSED_PARAM, char **argv UNUSED_PARAM)
+{
+	int strip = 0, fd = 0, i, n = 0, cap = 0;
+	long count = -1, skip = 0;
+	int delim = '\n';
+	const char *name = "MAPFILE";
+	char **vals = NULL;
+	struct rawbuf all = { NULL, 0, 0 };
+	char buf[4096];
+	char *p, *end;
+	ssize_t r;
+
+	while ((i = nextopt("td:n:s:u:O:C:c:")) != '\0') {
+		switch (i) {
+		case 't': strip = 1; break;
+		case 'd': delim = optionarg[0]; break;
+		case 'n': count = atol(optionarg); break;
+		case 's': skip = atol(optionarg); break;
+		case 'u': fd = atoi(optionarg); break;
+		default: break;
+		}
+	}
+	if (*argptr)
+		name = *argptr;
+	rb_put(&all, 'x');
+	all.n = 0;
+	while ((r = read(fd, buf, sizeof(buf))) != 0) {
+		if (r < 0) {
+			if (errno == EINTR)
+				continue;
+			break;
+		}
+		for (i = 0; i < r; i++)
+			rb_put(&all, buf[i]);
+	}
+	p = all.s;
+	end = all.s + all.n;
+	while (p < end && count != 0) {
+		char *q = memchr(p, delim, end - p);
+		char *stop = q ? q + 1 : end;
+		size_t len = (q && strip) ? (size_t)(q - p) : (size_t)(stop - p);
+
+		if (skip > 0) {
+			skip--;
+		} else {
+			if (n >= cap) {
+				cap = cap * 2 + 64;
+				vals = ckrealloc(vals, cap * sizeof(char *));
+			}
+			vals[n] = ckmalloc(len + 1);
+			memcpy(vals[n], p, len);
+			vals[n][len] = '\0';
+			n++;
+			if (count > 0)
+				count--;
+		}
+		p = stop;
+	}
+	{
+		char **keys = ckzalloc((n + 1) * sizeof(char *));
+		arr_assign(name, keys, vals, n, 0);
+		free(keys);
+	}
+	for (i = 0; i < n; i++)
+		free(vals[i]);
+	free(vals);
+	free(all.s);
+	return 0;
+}
