+/* SECONDS: whole seconds since the shell started, or since it was set
+ * (counting on from the value given). */
+static void FAST_FUNC
+change_shellsecs(const char *value)
+{
+	static long long base;
+	static smallint based;
+	struct timeval tv;
+
+	xgettimeofday(&tv);
+	if (value) {
+		base = tv.tv_sec - strtoll(value, NULL, 10);
+		based = 1;
+		return;
+	}
+	if (!based) {
+		base = tv.tv_sec;
+		based = 1;
+	}
+	setvar(vshsecs.var_text, utoa((unsigned)(tv.tv_sec - base)), VNOFUNC);
+	vshsecs.flags &= ~VNOFUNC;
+}
