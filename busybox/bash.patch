+/* ---- arrays ----
+ * Elements hang off the variable and are shared copy-on-write, so saving a
+ * variable for a function or subshell costs a reference, not a copy. Indexed
+ * arrays keep their elements sorted by index, associative ones in insertion
+ * order. var_text always holds element 0, which is what $name reads. */
+struct arrent {
+	arith_t idx;
+	char *key;
+	char *val;
+};
+struct arr {
+	int ref, n, cap;
+	struct arrent *e;
+};
+
+static void
+arr_release(struct arr *a)
+{
+	int i;
+
+	if (!a || --a->ref > 0)
+		return;
+	for (i = 0; i < a->n; i++) {
+		free(a->e[i].key);
+		free(a->e[i].val);
+	}
+	free(a->e);
+	free(a);
+}
+
+/* index of the element, or -(insertion point)-1 */
+static int
+arr_pos(struct arr *a, int assoc, const char *key, arith_t idx)
+{
+	int lo, hi;
+
+	if (!a)
+		return -1;
+	if (assoc) {
+		for (lo = 0; lo < a->n; lo++)
+			if (strcmp(a->e[lo].key, key) == 0)
+				return lo;
+		return -a->n - 1;
+	}
+	lo = 0;
+	hi = a->n - 1;
+	while (lo <= hi) {
+		int mid = (lo + hi) / 2;
+		if (a->e[mid].idx == idx)
+			return mid;
+		if (a->e[mid].idx < idx)
+			lo = mid + 1;
+		else
+			hi = mid - 1;
+	}
+	return -lo - 1;
+}
+
+static void
+arr_put(struct arr *a, int assoc, const char *key, arith_t idx, const char *val)
+{
+	int i = arr_pos(a, assoc, key, idx);
+
+	if (i >= 0) {
+		char *v = ckstrdup(val);
+		free(a->e[i].val);
+		a->e[i].val = v;
+		return;
+	}
+	i = -i - 1;
+	if (a->n >= a->cap) {
+		a->cap = a->cap * 2 + 8;
+		a->e = ckrealloc(a->e, a->cap * sizeof(a->e[0]));
+	}
+	memmove(&a->e[i + 1], &a->e[i], (a->n - i) * sizeof(a->e[0]));
+	a->e[i].idx = idx;
+	a->e[i].key = assoc ? ckstrdup(key) : NULL;
+	a->e[i].val = ckstrdup(val);
+	a->n++;
+}
+
+static void
+arr_del(struct arr *a, int assoc, const char *key, arith_t idx)
+{
+	int i = arr_pos(a, assoc, key, idx);
+
+	if (i < 0)
+		return;
+	free(a->e[i].key);
+	free(a->e[i].val);
+	a->n--;
+	memmove(&a->e[i], &a->e[i + 1], (a->n - i) * sizeof(a->e[0]));
+}
+
+/* The variable's own copy of its elements, made an array if it was not. */
+static struct arr *
+arr_own(struct var *vp)
+{
+	struct arr *a = vp->arr;
+
+	if (!a) {
+		a = ckzalloc(sizeof(*a));
+		a->ref = 1;
+		vp->arr = a;
+		if (!(vp->flags & VUNSET))
+			arr_put(a, vp->flags & VASSOC, "0", 0, strchrnul(vp->var_text, '=')[0] ? strchr(vp->var_text, '=') + 1 : "");
+	} else if (a->ref > 1) {
+		struct arr *c = ckzalloc(sizeof(*c));
+		int i;
+
+		c->ref = 1;
+		c->n = c->cap = a->n;
+		c->e = ckmalloc((a->n + 1) * sizeof(c->e[0]));
+		for (i = 0; i < a->n; i++) {
+			c->e[i].idx = a->e[i].idx;
+			c->e[i].key = a->e[i].key ? ckstrdup(a->e[i].key) : NULL;
+			c->e[i].val = ckstrdup(a->e[i].val);
+		}
