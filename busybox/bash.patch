+/* Relative dates counted from now: "now", "today", "yesterday",
+ * "tomorrow", "N unit [ago]", "+N unit", "next unit", "last unit", in any
+ * sequence. Units: second, minute, hour, day, week, fortnight, month, year
+ * (singular, plural or abbreviated as sec/min). */
+static int parse_relative(const char *s, struct tm *ptm)
+{
+	static const char units[] ALIGN1 =
+		"sec\0second\0min\0minute\0hour\0day\0week\0fortnight\0month\0year\0";
+	time_t now = time(NULL);
+	struct tm tm;
+	int matched = 0;
+
+	localtime_r(&now, &tm);
+	for (;;) {
+		char word[16];
+		long n = 1;
+		int len, idx;
+
+		s = skip_whitespace(s);
+		if (!*s)
+			break;
+		if (*s == '+' || *s == '-' || isdigit((unsigned char)*s)) {
+			char *e;
+			n = strtol(s, &e, 10);
+			if (e == s || (e == s + 1 && !isdigit((unsigned char)*s)))
+				return 0;
+			s = skip_whitespace(e);
+		}
+		len = 0;
+		while (isalpha((unsigned char)s[len]) && len < 15) {
+			word[len] = tolower((unsigned char)s[len]);
+			len++;
+		}
+		if (isalpha((unsigned char)s[len]))
+			return 0;
+		word[len] = '\0';
+		s += len;
+		if (!len)
+			return 0;
+		if (strcmp(word, "now") == 0 || strcmp(word, "today") == 0) {
+			matched = 1;
+			continue;
+		}
+		if (strcmp(word, "yesterday") == 0 || strcmp(word, "tomorrow") == 0) {
+			tm.tm_mday += word[0] == 'y' ? -1 : 1;
+			matched = 1;
+			continue;
+		}
+		if (strcmp(word, "next") == 0 || strcmp(word, "last") == 0) {
+			n = word[0] == 'n' ? 1 : -1;
+			s = skip_whitespace(s);
+			len = 0;
+			while (isalpha((unsigned char)s[len]) && len < 15) {
+				word[len] = tolower((unsigned char)s[len]);
+				len++;
+			}
+			word[len] = '\0';
+			s += len;
+		}
+		if (len > 1 && word[len - 1] == 's')
+			word[--len] = '\0';
+		idx = index_in_strings(units, word);
+		if (idx < 0)
+			return 0;
+		s = skip_whitespace(s);
+		if (strncasecmp(s, "ago", 3) == 0 && !isalpha((unsigned char)s[3])) {
+			n = -n;
+			s += 3;
+		}
+		switch (idx) {
+		case 0: case 1: tm.tm_sec += n; break;
+		case 2: case 3: tm.tm_min += n; break;
+		case 4: tm.tm_hour += n; break;
+		case 5: tm.tm_mday += n; break;
+		case 6: tm.tm_mday += 7 * n; break;
+		case 7: tm.tm_mday += 14 * n; break;
+		case 8: tm.tm_mon += n; break;
+		default: tm.tm_year += n; break;
+		}
+		matched = 1;
+	}
+	if (!matched)
+		return 0;
+	tm.tm_isdst = -1;
+	if (mktime(&tm) == (time_t)-1)
+		return 0;
+	*ptm = tm;
+	return 1;
+}
