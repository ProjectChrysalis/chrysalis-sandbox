+/* The two halves of the "time" keyword, which the parser places around the
+ * pipeline it times. Only wall-clock time is measurable here. */
+static int FAST_FUNC
+timekwcmd(int argc UNUSED_PARAM, char **argv)
+{
+	static struct timespec started[32];
+	static int depth;
+	int status = exitstatus;
+	struct timespec now;
+	long long ms;
+
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	if (strcmp(argv[1], "start") == 0) {
+		if (depth < 32)
+			started[depth] = now;
+		depth++;
+		return status;
+	}
+	if (depth == 0)
+		return status;
+	depth--;
+	if (depth >= 32)
+		return status;
+	ms = (now.tv_sec - started[depth].tv_sec) * 1000LL
+		+ (now.tv_nsec - started[depth].tv_nsec) / 1000000;
+	if (argv[1][3] == 'p')
+		fprintf(stderr, "real %lld.%02lld\n", ms / 1000, ms % 1000 / 10);
+	else
+		fprintf(stderr, "\nreal\t%lldm%lld.%03llds\n", ms / 60000, ms / 1000 % 60, ms % 1000);
+	return status;
 }
 
