+/* A word that parses and expands raw when used: kind "" is a double-quoted
+ * word, "~" a regex (quoted parts literal), "(" a list kept unexpanded. */
+static char *
+rawword_put(char *out, const char *kind, const char *raw)
+{
+	STPUTC(CTLQUOTEMARK, out);
+	STPUTC(CTLVAR, out);
+	STPUTC(VSRAW, out);
+	while (*kind)
+		STPUTC(*kind++, out);
+	STPUTC('=', out);
+	out = putraw(out, raw);
+	STPUTC(CTLENDVAR, out);
+	STPUTC(CTLQUOTEMARK, out);
+	return out;
+}
