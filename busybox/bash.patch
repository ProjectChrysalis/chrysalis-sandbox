+/* The end of the quoted part or substitution that starts at s. */
+static const char *
+rawskip(const char *s)
+{
+	char open, close;
+	int depth;
+
+	if (*s == '\'') {
+		s = strchrnul(s + 1, '\'');
+		return *s ? s + 1 : s;
+	}
+	if (*s == '"' || *s == '`') {
+		char q = *s++;
+		while (*s && *s != q) {
+			if (*s == '\\' && s[1])
+				s += 2;
+			else if (q == '"' && (*s == '`' || (*s == '$' && (s[1] == '(' || s[1] == '{'))))
+				s = rawskip(s);
+			else
+				s++;
+		}
+		return *s ? s + 1 : s;
+	}
+	open = s[1];
+	close = open == '(' ? ')' : '}';
+	s += 2;
+	depth = 1;
+	while (*s) {
+		if (*s == '\\' && s[1]) {
+			s += 2;
+			continue;
+		}
+		if (*s == '\'' || *s == '"' || *s == '`'
+		 || (*s == '$' && (s[1] == '(' || s[1] == '{'))
+		) {
+			s = rawskip(s);
+			continue;
+		}
+		if (*s == open)
+			depth++;
+		else if (*s == close && --depth == 0)
+			return s + 1;
+		s++;
+	}
+	return s;
+}
