+	if (m) {
+		for (i = 0; i < n && i < 10; i++) {
+			size_t len = m[i].rm_so < 0 ? 0 : m[i].rm_eo - m[i].rm_so;
+			vals[k] = ckmalloc(len + 1);
+			memcpy(vals[k], m[i].rm_so < 0 ? "" : s + m[i].rm_so, len);
+			vals[k][len] = '\0';
+			keys[k++] = NULL;
+		}
+	}
+	arr_assign("BASH_REMATCH", keys, vals, k, 0);
+	for (i = 0; i < k; i++)
+		free(vals[i]);
+}
