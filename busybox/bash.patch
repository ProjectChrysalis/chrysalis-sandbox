+/* Rewrites shell text as the body of a double-quoted word: quoted parts
+ * become literal text (and, for a regex, literal regex text), while
+ * substitutions stay as written. */
+static char *
+dqify(const char *s, int regex)
+{
+	struct rawbuf rb = { NULL, 0, 0 };
+	const char *e;
+
+	rb_put(&rb, 'x');
+	rb.n = 0;
+	rb.s[0] = '\0';
+	while (*s) {
+		if (*s == '\'' || *s == '"') {
+			const char *in = s + 1, *end;
+			e = rawskip(s);
+			end = (e > in && e[-1] == *s) ? e - 1 : e;
+			if (*s == '\'') {
+				for (; in < end; in++)
+					rb_dq(&rb, (unsigned char)*in, regex);
+			} else if (regex) {
+				char *body = ckmalloc(end - in + 1), *v, *q;
+				memcpy(body, in, end - in);
+				body[end - in] = '\0';
+				v = rawexpand(body, DQSYNTAX, EXP_QUOTED, NULL, 1);
+				for (q = v; *q; q++)
+					rb_dq(&rb, (unsigned char)*q, 1);
+				free(v);
+				free(body);
+			} else {
+				for (; in < end; in++)
+					rb_put(&rb, *in);
+			}
+			s = e;
+		} else if (*s == '\\' && s[1]) {
+			if (regex)
