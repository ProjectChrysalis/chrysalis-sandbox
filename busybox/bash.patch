+static int FAST_FUNC
+shoptcmd(int argc UNUSED_PARAM, char **argv UNUSED_PARAM)
+{
+	int set = -1, quiet = 0, print = 0, opt_o = 0, status = 0, i;
+	char **ap;
+
+	while ((i = nextopt("supqo")) != '\0') {
+		if (i == 's')
+			set = 1;
+		else if (i == 'u')
+			set = 0;
+		else if (i == 'q')
+			quiet = 1;
+		else if (i == 'p')
+			print = 1;
+		else
+			opt_o = 1;
+	}
+	if (opt_o) {
+		/* shopt -o name: the set -o options */
+		for (ap = argptr; *ap; ap++) {
+			int idx = -1;
+			for (i = 0; i < NOPTS; i++)
+				if (strcmp(*ap, optnames(i)) == 0)
+					idx = i;
+			if (idx < 0) {
+				bb_error_msg("shopt: %s: invalid option name", *ap);
+				status = 1;
+				continue;
+			}
+			if (set >= 0)
+				optlist[idx] = set;
+			else if (!optlist[idx])
+				status = 1;
+		}
+		return status;
+	}
+	if (!*argptr) {
+		const char *n = shopt_names;
+		for (i = 0; *n; n += strlen(n) + 1, i++) {
+			int on = shopt_flags & (1 << i);
+			if (set < 0 || on == (set ? (1 << i) : 0))
+				out1fmt(print ? "shopt %s %s\n" : "%-16s%s\n",
+					print ? (on ? "-s" : "-u") : n, print ? n : (on ? "on" : "off"));
+		}
+		return 0;
+	}
+	for (ap = argptr; *ap; ap++) {
+		int bit = index_in_strings(shopt_names, *ap);
+		int noop = index_in_strings(shopt_unavailable, *ap);
+		int on;
+
+		if (bit < 0 && noop < 0) {
+			bb_error_msg("shopt: %s: invalid shell option name", *ap);
+			status = 1;
+			continue;
+		}
+		if (set >= 0) {
+			if (bit >= 0)
+				shopt_flags = set ? shopt_flags | (1 << bit) : shopt_flags & ~(1 << bit);
+			else if (set) {
+				bb_error_msg("shopt: %s: unavailable in this shell", *ap);
+				status = 1;
+			}
+			continue;
+		}
+		on = bit >= 0 ? (shopt_flags >> bit) & 1 : 0;
+		if (!on)
+			status = 1;
+		if (!quiet)
+			out1fmt("%-16s%s\n", *ap, on ? "on" : "off");
+	}
+	return status;
+}
+
+static void
+out1c(char c)
+{
+	char b[2] = { c, '\0' };
+	out1str(b);
+}
+
+/* "declare -p" value quoting. */
+static void
+out1_dq(const char *s)
+{
+	out1c('"');
+	for (; *s; s++) {
+		if (*s == '"' || *s == '\\' || *s == '$' || *s == '`')
+			out1c('\\');
+		out1c(*s);
+	}
+	out1c('"');
+}
+
+static int
+declare_print(const char *name)
+{
+	struct var *vp = *findvar(name);
+	char fl[8], *f = fl;
+
+	if (!vp || ((vp->flags & VUNSET) && !(vp->flags & VATTRS))) {
+		bb_error_msg("declare: %s: not found", name);
+		return 1;
+	}
+	if (vp->flags & VARRAY) *f++ = 'a';
+	if (vp->flags & VASSOC) *f++ = 'A';
+	if (vp->flags & VINTEGER) *f++ = 'i';
+	if (vp->flags & VLOWER) *f++ = 'l';
+	if (vp->flags & VREADONLY) *f++ = 'r';
+	if (vp->flags & VUPPER) *f++ = 'u';
+	if (vp->flags & VEXPORT) *f++ = 'x';
+	if (f == fl)
+		*f++ = '-';
+	*f = '\0';
+	out1fmt("declare -%s %s", fl, name);
+	if (vp->flags & (VARRAY | VASSOC)) {
+		int i, n = vp->arr ? vp->arr->n : 0;
+		if (vp->flags & VUNSET && !n) {
+			out1c('\n');
+			return 0;
+		}
+		out1str("=(");
+		for (i = 0; i < n; i++) {
+			struct arrent *e = &vp->arr->e[i];
+			if (i)
+				out1c(' ');
+			if (vp->flags & VASSOC)
+				out1fmt("[%s]=", e->key);
+			else
+				out1fmt("[" ARITH_FMT "]=", e->idx);
+			out1_dq(e->val);
+		}
+		out1str((vp->flags & VASSOC) && n ? " )\n" : ")\n");
+		return 0;
+	}
+	if (!(vp->flags & VUNSET)) {
+		out1c('=');
+		out1_dq(var_end(vp->var_text));
+	}
+	out1c('\n');
+	return 0;
+}
+
+/* declare, typeset and local. */
+static int FAST_FUNC
+declarecmd(int argc UNUSED_PARAM, char **argv)
+{
+	int is_local = argv[0][0] == 'l';
+	int on = 0, off = 0, global = 0, print = 0, funcs = 0, status = 0;
+	char **ap = argptr;
+
+	if (is_local && !funcname && !localvar_stack)
+		ash_msg_and_raise_error("not in a function");
+	for (; *ap && (**ap == '-' || **ap == '+') && (*ap)[1]; ap++) {
+		const char *o = *ap;
+		int plus = *o == '+';
+
+		if (strcmp(o, "--") == 0) {
+			ap++;
+			break;
+		}
+		for (o++; *o; o++) {
+			int f = 0;
+			switch (*o) {
+			case 'a': f = VARRAY; break;
+			case 'A': f = VASSOC; break;
+			case 'i': f = VINTEGER; break;
+			case 'l': f = VLOWER; break;
+			case 'u': f = VUPPER; break;
+			case 'r': f = VREADONLY; break;
+			case 'x': f = VEXPORT; break;
+			case 'g': global = 1; break;
+			case 'p': print = 1; break;
+			case 'f': case 'F': funcs = *o; break;
+			case 't': break;
+			case 'n':
+				bb_error_msg("%s: -n: name references are not supported; use ${!name} or eval", argv[0]);
+				return 2;
+			default:
+				bb_error_msg("%s: -%c: invalid option", argv[0], *o);
+				return 2;
+			}
+			if (plus)
+				off |= f;
+			else
+				on |= f;
+		}
+	}
+	if (!*ap) {
+		if (funcs) {
+			struct tblentry **pp, *cmdp;
+			for (pp = cmdtable; pp < &cmdtable[CMDTABLESIZE]; pp++)
+				for (cmdp = *pp; cmdp; cmdp = cmdp->next)
+					if (cmdp->cmdtype == CMDFUNCTION)
+						out1fmt("declare -f %s\n", cmdp->cmdname);
+			return 0;
+		}
+		if (print || !(on | off)) {
+			char **ep, **epend;
+			ep = listvars(0, VUNSET, NULL, &epend);
+			qsort(ep, epend - ep, sizeof(char *), vpcmp);
+			for (; ep < epend; ep++) {
+				char *nm = ckstrdup(*ep);
+				*strchrnul(nm, '=') = '\0';
+				if (print)
+					declare_print(nm);
+				else {
+					struct var *vp = *findvar(nm);
+					out1str(nm);
+					out1c('=');
+					out1str(single_quote(var_end(vp->var_text)));
+					out1c('\n');
+				}
+				free(nm);
+			}
+		}
+		return 0;
+	}
+	for (; *ap; ap++) {
+		char *text = *ap;
+		char *e = (char *)endofname(text);
+		char *name;
+		struct var *vp;
+		int has_value;
+
+		if (e == text) {
+			bb_error_msg("%s: '%s': not a valid identifier", argv[0], text);
+			status = 1;
+			continue;
+		}
+		name = ckmalloc(e - text + 1);
+		memcpy(name, text, e - text);
+		name[e - text] = '\0';
+		has_value = *e != '\0';
+		if (funcs) {
+			struct tblentry *cmdp = cmdlookup(name, 0);
+			if (cmdp && cmdp->cmdtype == CMDFUNCTION)
+				out1fmt(funcs == 'F' ? "%s\n" : "declare -f %s\n", name);
+			else
+				status = 1;
+		} else if (print && !has_value) {
+			status |= declare_print(name);
+		} else {
+			if ((is_local || (funcname && !global)) && localvar_stack)
+				mklocal(name, 0);
+			vp = *findvar(name);
+			if (!vp) {
+				/* declared, still unset, attributes kept */
+				vp = setvar(name, "", 0);
+				vp->flags |= VUNSET;
+			}
+			if ((vp->flags & VREADONLY) && (has_value || (on & ~VREADONLY))) {
+				bb_error_msg("%s: %s: readonly variable", argv[0], name);
+				status = 1;
+				free(name);
+				continue;
+			}
+			if ((on & VASSOC) && !(vp->flags & VASSOC)) {
+				if (vp->arr) {
+					bb_error_msg("%s: %s: cannot convert indexed to associative array", argv[0], name);
+					status = 1;
+					free(name);
+					continue;
+				}
+				vp->flags |= VASSOC;
+				vp->flags &= ~VARRAY;
+				arr_own(vp);
+			} else if ((on & VARRAY) && !(vp->flags & (VARRAY | VASSOC))) {
+				arr_own(vp);
+			}
+			vp->flags |= on & (VINTEGER | VLOWER | VUPPER | VEXPORT);
+			vp->flags &= ~(off & (VINTEGER | VLOWER | VUPPER | VEXPORT));
+			if (on & VLOWER)
+				vp->flags &= ~VUPPER;
+			if (on & VUPPER)
+				vp->flags &= ~VLOWER;
+			if (has_value)
+				assignword(text, 0, 0);
+			if (on & VREADONLY) {
+				vp = *findvar(name);
+				if (vp)
+					vp->flags |= VREADONLY;
+			}
+		}
+		free(name);
+	}
+	return status;
+}
