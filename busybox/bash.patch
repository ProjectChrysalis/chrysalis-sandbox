+/* Raw text expanded like a double-quoted word. */
+static char *
+rawdq(const char *raw, int inword)
+{
+	char *dq = dqify(raw, 0);
+	char *r = rawexpand(dq, DQSYNTAX, EXP_QUOTED, NULL, inword);
+	free(dq);
+	return r;
+}
+
+/* The pattern after =~: quoted parts match literally. */
+static char *
+rawregex(const char *raw)
+{
+	char *dq = dqify(raw, 1);
+	char *r = rawexpand(dq, DQSYNTAX, EXP_QUOTED, NULL, 1);
+	free(dq);
+	return r;
+}
+
+/* The elements of a name=( ... ) list, assigned. */
+static void
+compound_assign(const char *name, const char *s, int append)
+{
+	char **keys = NULL, **vals = NULL;
+	int n = 0, cap = 0, i;
+
+	for (;;) {
+		const char *start;
+		char *word;
+
+		while (*s == ' ' || *s == '\t' || *s == '\n')
+			s++;
+		if (!*s)
+			break;
+		start = s;
+		if (*s == '[') {
+			/* [key with spaces]=value */
+			int depth = 0;
+			do {
+				if (*s == '\\' && s[1])
+					s++;
+				else if (*s == '\'' || *s == '"')
+					s = rawskip(s) - 1;
+				else if (*s == '[')
+					depth++;
+				else if (*s == ']')
+					depth--;
+				s++;
+			} while (*s && depth);
+		}
+		while (*s && *s != ' ' && *s != '\t' && *s != '\n') {
+			if (*s == '\\' && s[1])
+				s += 2;
+			else if (*s == '\'' || *s == '"' || *s == '`'
+			 || (*s == '$' && (s[1] == '(' || s[1] == '{'))
+			)
+				s = rawskip(s);
+			else
+				s++;
+		}
+		word = ckmalloc(s - start + 1);
+		memcpy(word, start, s - start);
+		word[s - start] = '\0';
+		if (n + 64 > cap) {
+			cap = cap * 2 + 64;
+			keys = ckrealloc(keys, cap * sizeof(char *));
+			vals = ckrealloc(vals, cap * sizeof(char *));
+		}
+		if (word[0] == '[') {
+			const char *q = word + 1;
+			int depth = 1;
+
+			while (*q) {
+				if (*q == '\\' && q[1])
+					q += 2;
+				else if (*q == '\'' || *q == '"' || *q == '`'
+				 || (*q == '$' && (q[1] == '(' || q[1] == '{'))
+				)
+					q = rawskip(q);
+				else if (*q == '[')
+					depth++, q++;
+				else if (*q == ']' && --depth == 0)
+					break;
+				else
+					q++;
+			}
+			if (*q == ']' && (q[1] == '=' || (q[1] == '+' && q[2] == '='))) {
+				char *k = ckmalloc(q - word);
+				memcpy(k, word + 1, q - word - 1);
+				k[q - word - 1] = '\0';
+				keys[n] = rawdq(k, 0);
+				free(k);
+				vals[n] = rawexpand(q + (q[1] == '+' ? 3 : 2), BASESYNTAX, EXP_TILDE, NULL, 0);
+				n++;
+				free(word);
+				continue;
+			}
+		}
+		{
+			int nf;
+			char *f = rawexpand(word, BASESYNTAX, EXP_FULL | EXP_TILDE, &nf, 0);
+			char *q = f;
+
+			if (n + nf > cap) {
+				cap = n + nf + 64;
+				keys = ckrealloc(keys, cap * sizeof(char *));
+				vals = ckrealloc(vals, cap * sizeof(char *));
+			}
+			for (i = 0; i < nf; i++) {
+				keys[n] = NULL;
+				vals[n++] = ckstrdup(q);
+				q += strlen(q) + 1;
+			}
+			free(f);
+		}
+		free(word);
+	}
+	arr_assign(name, keys, vals, n, append);
+	for (i = 0; i < n; i++) {
+		free(keys[i]);
+		free(vals[i]);
+	}
+	free(keys);
+	free(vals);
+}
+
+/* One expanded assignment word: name=v, name+=v, name[k]=v, name=(...). */
+static void
+assignword(char *text, int flags, int local)
+{
+	char *e = (char *)endofname(text);
+	char *sub = NULL, *val, *name;
+	int append = 0, compound;
+	struct var *vp;
+
+	if (*e == '[') {
+		char *q = e + 1;
+		int depth = 1;
+		while (*q && depth) {
+			if (*q == '[')
+				depth++;
+			else if (*q == ']')
+				depth--;
+			q++;
+		}
+		sub = ckmalloc(q - e);
+		memcpy(sub, e + 1, q - e - 2);
+		sub[q - e - 2] = '\0';
+		val = q;
+	} else
+		val = e;
+	if (*val == '+') {
+		append = 1;
+		val++;
+	}
+	if (*val == '=')
+		val++;
+	compound = val[0] == '\001' && val[1] == '(';
+	name = ckmalloc(e - text + 1);
+	memcpy(name, text, e - text);
+	name[e - text] = '\0';
+	vp = *findvar(name);
+	if (!sub && !append && !compound
+	 && !(vp && (vp->flags & (VINTEGER | VLOWER | VUPPER)))
+	) {
+		if (local)
+			mklocal(text, flags);
+		else
+			setvareq(text, flags);
+		free(name);
+		return;
+	}
+	if (local)
+		mklocal(name, flags);
+	if (compound)
+		compound_assign(name, val + 2, append);
+	else if (sub)
+		arr_set(name, sub, val, append);
+	else {
+		vp = *findvar(name);
+		if (vp && vp->arr)
+			arr_set(name, "0", val, append);
+		else {
+			char *nv = attr_value(vp ? vp->flags : 0, lookupvar(name), val, append);
+			setvar(name, nv, flags);
+			free(nv);
+		}
+	}
+	free(sub);
+	free(name);
+}
