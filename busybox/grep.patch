+/* GNU-style filters for -r: --include and --exclude match a file's name,
+ * --exclude-dir a directory's, as shell globs with {a,b} alternatives. They
+ * are taken out of argv before option parsing. Applets run in-process here,
+ * so every list is reset on entry rather than left to a previous grep. */
+static llist_t *include_globs, *exclude_globs, *exclude_dir_globs;
+static smallint implicit_dot;
+
+static int brace_fnmatch(const char *pat, const char *name)
+{
+	const char *open = strchr(pat, '{');
+	const char *close, *alt;
+	if (!open || !(close = strchr(open, '}')))
+		return fnmatch(pat, name, 0) == 0;
+	for (alt = open + 1; alt <= close; ) {
+		const char *end = alt;
+		char *one;
+		int hit;
+		while (end < close && *end != ',')
+			end++;
+		one = xasprintf("%.*s%.*s%s", (int)(open - pat), pat, (int)(end - alt), alt, close + 1);
+		hit = brace_fnmatch(one, name);
+		free(one);
+		if (hit)
+			return 1;
+		alt = end + 1;
+	}
+	return 0;
+}
+
+static int glob_hit(llist_t *list, const char *name)
+{
+	for (; list; list = list->link)
+		if (brace_fnmatch(list->data, name))
+			return 1;
+	return 0;
+}
+
+static void take_path_filters(char **argv)
+{
+	char **in = argv + 1, **out = argv + 1;
+	include_globs = exclude_globs = exclude_dir_globs = NULL;
+	implicit_dot = 0;
+	while (*in) {
+		char *arg = *in++;
+		llist_t **list = NULL;
+		const char *rest = NULL;
+		if (strcmp(arg, "--") == 0) {
+			*out++ = arg;
+			while (*in)
+				*out++ = *in++;
+			break;
+		}
+		if ((rest = is_prefixed_with(arg, "--include")) != NULL)
+			list = &include_globs;
+		else if ((rest = is_prefixed_with(arg, "--exclude-dir")) != NULL)
+			list = &exclude_dir_globs;
+		else if ((rest = is_prefixed_with(arg, "--exclude")) != NULL)
+			list = &exclude_globs;
+		if (list && *rest == '=') {
+			llist_add_to(list, (char *)rest + 1);
+			continue;
+		}
+		if (list && *rest == '\0' && *in) {
+			llist_add_to(list, *in++);
+			continue;
+		}
+		*out++ = arg;
+	}
+	*out = NULL;
+}
+
+/* A NUL in the first block marks a binary file, which -r skips unless -a. */
+static int looks_binary(FILE *file)
+{
+	char buf[4096];
+	size_t n = fread(buf, 1, sizeof buf, file);
+	rewind(file);
+	return memchr(buf, 0, n) != NULL;
+}
+
+static int FAST_FUNC dir_action_grep(struct recursive_state *state,
+		const char *dirname,
+		struct stat *statbuf UNUSED_PARAM)
+{
+	if (state->depth && exclude_dir_globs && glob_hit(exclude_dir_globs, bb_basename(dirname)))
+		return SKIP;
+	return TRUE;
+}
