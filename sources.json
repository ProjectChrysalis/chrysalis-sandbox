{
  "runtime": {
    "name": "chrysalis-sandbox",
    "version": "0.3.6",
    "license": "GPL-2.0-only",
    "source": "https://github.com/ProjectChrysalis/chrysalis-sandbox",
    "note": "the runtime links busybox and wasm-git (both GPL-2.0-only), so the combined work is GPL-2.0-only; wasi-sh (ISC), MicroPython (MIT), QuickJS (MIT) and fflate (MIT) are compatible"
  },
  "wasi-sh": {
    "version": "0.11.0",
    "license": "ISC",
    "source": "https://github.com/alganet/wasi-sh",
    "vendored": [
      "vendor/wasi-sh/src",
      "vendor/wasi-sh/dist/busybox.wasm"
    ],
    "note": "fork-free shell + busybox ash/applets compiled to wasm32-wasi"
  },
  "wasm-git": {
    "version": "0.0.17",
    "license": "GPL-2.0-only",
    "source": "https://github.com/petersalomonsen/wasm-git",
    "library": "libgit2 1.9.4 (GPL-2.0-only with linking exception)",
    "librarySource": "https://libgit2.org",
    "vendored": [
      "vendor/wasm-git/lg2.js",
      "vendor/wasm-git/lg2.wasm",
      "vendor/wasm-git/COPYING"
    ]
  },
  "micropython": {
    "version": "wasi variant",
    "license": "MIT",
    "source": "https://github.com/micropython/micropython",
    "artifact": "https://github.com/bamggm/micropython-wasm",
    "vendored": [
      "vendor/micropython/micropython-wasi.wasm"
    ]
  },
  "quickjs-ng": {
    "version": "wasmfile-release-sync",
    "license": "MIT",
    "source": "https://github.com/quickjs-ng/quickjs",
    "package": "@jitl/quickjs-ng-wasmfile-release-sync",
    "vendored": [
      "vendor/quickjs/quickjs.mjs",
      "vendor/quickjs/emscripten-module.wasm"
    ]
  },
  "fflate": {
    "version": "0.8.3",
    "license": "MIT",
    "source": "https://github.com/101arrowz/fflate",
    "vendored": [
      "vendor/fflate/fflate.mjs"
    ]
  },
  "busybox": {
    "version": "wasi-sh 0.11.0 build",
    "license": "GPL-2.0-only",
    "source": "https://busybox.net",
    "vendored": [
      "vendor/wasi-sh/dist/busybox.wasm"
    ]
  }
}
